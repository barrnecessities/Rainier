# --- Claude (summaries / clustering) ---
ANTHROPIC_API_KEY=sk-ant-...
BRIEF_MODEL=claude-sonnet-4-6        # or claude-opus-4-8 for best quality, claude-haiku-4-5-20251001 for cheapest

# --- Outbound email (SMTP). Gmail example below. ---
# For Gmail: enable 2FA, then create an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password
FROM_EMAIL=youraddress@gmail.com     # MUST be on your Amazon "Approved Personal Document E-mail List"

# --- Delivery targets (comma-separated allowed) ---
KINDLE_EMAIL=yourname_xxxx@kindle.com   # from Amazon > Manage Your Content & Devices > Preferences > Personal Document Settings
EMAIL_TO=brandonbarron52@gmail.com

# --- Readwise Reader (your saved tweets / bookmarked articles) ---
# Get your token at https://readwise.io/access_token
READWISE_TOKEN=
READWISE_LOCATIONS=new,later,shortlist   # which Reader locations to pull from
READWISE_TAG=                            # optional: only bookmarks with this Reader tag (e.g. kindle)
BOOKMARK_LOOKBACK_HOURS=30               # how far back to look for freshly-saved bookmarks
MAX_BOOKMARKS=15                         # cap per run (cost control)
BOOKMARK_DUMP_LOOKBACK_HOURS=168         # window for the weekly bookmarks digest (--bookmarks-dump)
MAX_BOOKMARKS_DUMP=50                    # cap for the digest / one-off full send (--bookmarks-dump --all)
READWISE_ARCHIVE_AFTER=false             # true = move processed bookmarks to Reader Archive so they never repeat
RELATED_PER_BOOKMARK=3                   # related articles to attach per bookmark (0 = off)

# --- Tuning (optional) ---
MAX_ARTICLES=60
LOOKBACK_HOURS=28
EXTRACT_CONCURRENCY=5
BRIEF_TZ=America/New_York
