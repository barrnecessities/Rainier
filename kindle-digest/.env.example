# Twitter API v2 OAuth 2.0
# Create a project + app at https://developer.twitter.com/en/portal
# App type must be "Web App" (confidential client), callback URL: http://localhost:3333/callback
# Scopes: bookmark.read tweet.read users.read offline.access
TWITTER_CLIENT_ID=your_twitter_oauth2_client_id
TWITTER_CLIENT_SECRET=your_twitter_oauth2_client_secret
# Run `npm run setup-twitter` once locally to generate this value
TWITTER_REFRESH_TOKEN=your_long_lived_refresh_token

# NewsAPI.org — free tier (100 req/day), register at https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key

# The Economist session cookie
# Open DevTools in browser while on economist.com → Network tab → any request → copy Cookie header value
ECONOMIST_SESSION_COOKIE=your_economist_session_cookie_string

# Anthropic — https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-...

# Gmail SMTP — must use an App Password (NOT your account password)
# Requires 2FA enabled: https://myaccount.google.com/apppasswords → Mail → Other
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Amazon Kindle personal document email
# Find at: Amazon → Manage Your Content and Devices → Preferences → Personal Document Settings
# IMPORTANT: also add GMAIL_USER to the Approved Personal Document E-mail List on that same page
KINDLE_EMAIL=yourname@kindle.com

# Optional tuning
MAX_ITEMS_PER_SOURCE=10
