generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  passwordHash String
  age          Int            @default(36)
  summitDate   DateTime
  trainingPlan TrainingPlan[]
  whoopMetrics WhoopMetric[]
  checklist    ChecklistItem[]
}

model TrainingPlan {
  id           Int            @id @default(autoincrement())
  userId       Int
  startDate    DateTime
  endDate      DateTime
  intensity    String
  currentWeek  Int
  user         User           @relation(fields: [userId], references: [id])
  weeks        TrainingWeek[]
}

model TrainingWeek {
  id              Int      @id @default(autoincrement())
  planId           Int
  weekNumber       Int
  plannedHours     Float
  completedHours   Float
  targetElevation  Int
  plan             TrainingPlan @relation(fields: [planId], references: [id])
  workouts         Workout[]
}

model Workout {
  id             Int      @id @default(autoincrement())
  weekId          Int
  workoutType     String
  durationMin     Int
  elevationGain   Int
  loadLbs         Int?
  completed       Boolean  @default(false)
  week            TrainingWeek @relation(fields: [weekId], references: [id])
}

model ChecklistItem {
  id          Int      @id @default(autoincrement())
  userId       Int
  day         DateTime
  category    String
  label       String
  done        Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id])
}

model WhoopMetric {
  id                Int      @id @default(autoincrement())
  userId             Int
  day               DateTime
  recovery          Int
  strain            Float
  sleepPerformance  Int
  user              User     @relation(fields: [userId], references: [id])
}
