# Required
APP_PASSWORD=changeme_strong_password

# Home Assistant (local Raspberry Pi address)
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=your_ha_long_lived_access_token_here

# Session signing secret (generate with: openssl rand -hex 32)
SESSION_SECRET=changeme_generate_with_openssl

# Eight Sleep credentials (used for alarm coordination)
EIGHT_EMAIL=your@email.com
EIGHT_PASSWORD=your_eight_sleep_password

# Optional: approved email for 8sleep (defaults to EIGHT_EMAIL)
EIGHT_APPROVED_EMAIL=your@email.com
